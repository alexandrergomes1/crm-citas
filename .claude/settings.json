      "Bash(git branch --list*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(node .claude/hooks/guarda.test.mjs)",
      "Bash(node .claude/hooks/inicio-de-sessao.test.mjs)",
