    "playwright@synced": true,
    "skill-reviewer@synced": true,
    "claude-md-management@synced": true,
    "skill-creator@synced": true,
    "claude-code-setup@synced": true,
    "agencia-360@synced": false,
    "animatedwebs@synced": false,
    "brand-voice@synced": false,
    "career-compass@synced": false,
    "claude-security@synced": false,
    "cowork-plugin-management@synced": false,
    "customer-support@synced": false,
