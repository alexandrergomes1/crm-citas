      "Skill(engineering:tech-debt)",
      "Skill(engineering:documentation)",
      "Skill(engineering:standup)",
      "Skill(product-management:brainstorm)",
      "Skill(product-management:product-brainstorming)",
      "Skill(product-management:write-spec)",
      "Skill(product-management:sprint-planning)",
      "Skill(product-management:roadmap-update)",
      "Skill(product-management:metrics-review)",
      "Skill(product-management:synthesize-research)",
      "Skill(product-management:competitive-brief)",
      "Skill(product-management:stakeholder-update)",
      "Skill(ui-design-review:compare)",
      "Skill(ui-design-review:polish)",
      "Skill(ui-design-review:review)",
      "Skill(ui-design-review:ui-compare)",
      "Skill(ui-design-review:ui-polish)",
      "Skill(ui-design-review:ui-review)",
      "Agent(backend-design:schema-reviewer)",
      "Agent(backend-design:security-reviewer)",
      "Agent(backend-design:component-architect)",
      "Agent(backend-design:incident-investigator)",
      "Agent(backend-design:incident-thinker)",
      "Agent(pr-review-toolkit:code-reviewer)",
      "Agent(pr-review-toolkit:code-simplifier)",
      "Agent(pr-review-toolkit:comment-analyzer)",
      "Agent(pr-review-toolkit:type-design-analyzer)",
      "Agent(claude-security:claude-security)",
      "mcp__claude-code-remote__create_session"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/inicio-de-sessao.mjs\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/inicio-de-sessao.mjs\" --resumida"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
