{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker novo do crm-citas (não é o Worker de produção do crm-agenda). Ligar ao GitHub (Workers Builds) no painel.
  "name": "crm-citas",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Logs do console continuam; o registro automático de cada pedido (URL com o token de /forms e /pagar) fica desligado.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "placement": { "mode": "smart" },
  // Só valores públicos: URL e chave publishable do projeto Supabase de DESENVOLVIMENTO (Beauty System),
  // usado nas prévias e no piloto. Na virada (F4) trocam para o projeto de produção.
  // A chave service_role é segredo (painel da Cloudflare / wrangler secret), nunca aqui.
  // APP_ORIGIN: endereço público fixo, usado nos links de "Esqueci a senha" e de criar senha (não vem do Host do pedido).
  // A prévia fixa (env.previas, abaixo) tem o próprio endereço. Sem a variável (máquina local) vale a origem do pedido.
  // Na virada (F4), trocar pelo domínio de produção.
  "vars": {
    "APP_ORIGIN": "https://crm-citas.alexandrergomes.workers.dev",
    "SUPABASE_URL": "https://qjcabltvchmzmpigiyrv.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_AKdZzdMZCxW6n4cysCIjYw_f5ZUqibe"
  },
  // Ambiente de prévias (Worker crm-citas-previas, branch fixa `previas`): onde o Alexandre valida antes de ir para a
  // produção. Build com CLOUDFLARE_ENV=previas. Mesmo banco de DESENVOLVIMENTO, nunca o de produção. `vars` não herda
  // do topo: repetidas aqui. O segredo SUPABASE_SERVICE_ROLE_KEY vai no painel do Worker crm-citas-previas (ainda não criado).
  "env": {
    "previas": {
      "name": "crm-citas-previas",
      "workers_dev": true,
      "vars": {
        "APP_ORIGIN": "https://crm-citas-previas.alexandrergomes.workers.dev",
        "SUPABASE_URL": "https://qjcabltvchmzmpigiyrv.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_AKdZzdMZCxW6n4cysCIjYw_f5ZUqibe"
      }
    }
  },
  // Prévias por branch (Workers Builds): cada branch publica em <branch-com-hifens>-crm-citas-previas.alexandrergomes.workers.dev,
  // onde o dono confere a tela antes do merge (docs/guias/git-e-deploy.md). Mesmo banco de DESENVOLVIMENTO.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://qjcabltvchmzmpigiyrv.supabase.co",
      "SUPABASE_ANON_KEY": "sb_publishable_AKdZzdMZCxW6n4cysCIjYw_f5ZUqibe"
    },
    "placement": { "mode": "smart" }
  }
}
